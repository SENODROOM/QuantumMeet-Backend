PORT=5000
MONGO_URI=mongodb://localhost:27017/quantummeet
CLIENT_URL=http://localhost:3000

# Optional comma-separated extra CORS origins (custom domains, etc.)
EXTRA_ALLOWED_ORIGINS=

# JWT (classroom auth)
JWT_SECRET=

# Vercel Blob (classroom file uploads — set automatically by Vercel when
# Blob storage is enabled on the project; only needed manually for local dev)
BLOB_READ_WRITE_TOKEN=
