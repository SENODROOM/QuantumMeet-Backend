PORT=5000
MONGO_URI=mongodb://localhost:27017/quantummeet
CLIENT_URL=http://localhost:3000

# Optional comma-separated extra CORS origins (custom domains, etc.)
EXTRA_ALLOWED_ORIGINS=

# JWT (classroom auth) + room host tokens
JWT_SECRET=
ROOM_TOKEN_SECRET=

# Vercel Cron auth for /api/cron/*
CRON_SECRET=

# Optional Sentry
# SENTRY_DSN=

# Feature flags
# FEATURE_LONG_POLL=1
# FEATURE_SFU=0
# FEATURE_ORGS=0
# MESH_SOFT_CAP=10
# SFU_THRESHOLD=12

# Vercel Blob (classroom file uploads — set automatically by Vercel when
# Blob storage is enabled on the project; only needed manually for local dev)
BLOB_READ_WRITE_TOKEN=
